# Connection string used by Prisma for this isolated instance's database.
# Points to this instance's dedicated PostgreSQL database.
MESSAGING_DATABASE_URL="postgresql://messaging:messaging@localhost:5432/messaging?schema=public"

# Secret used to verify the JWT presented by the host project's clients (HS256).
# The token's `sub` claim is treated as the authenticated user id.
MESSAGING_JWT_SECRET="change-me-in-every-deployed-instance"

# Optional: reject any token whose `iat` is older than this (guards against
# non-expiring tokens). Accepts a timespan ("24h", "7d") or seconds ("3600").
# Unset = not enforced (default). Recommended for any deployed instance:
# MESSAGING_JWT_MAX_AGE="24h"

# NATS server used to publish integration events (pub/sub only, never request/response).
MESSAGING_NATS_URL="nats://localhost:4222"

# Optional: HTTP port (defaults to 3100)
# PORT=3100

# Optional: reverse-proxy topology, for correct client-IP resolution in rate
# limiting (Express `trust proxy` + WebSocket X-Forwarded-For). Default: 1 (a
# single proxy hop: nginx / traefik / k8s ingress). Use "false" for direct
# exposure with no proxy; also accepts an integer hop count, "loopback", an IP
# or a CIDR.
# MESSAGING_TRUST_PROXY=1

# Optional: allowed browser origins for CORS (HTTP + Socket.IO), comma-separated.
# When unset, defaults to the Vite dev origins (localhost:5173, localhost:5174 and
# their 127.0.0.1 variants). Set this explicitly for any deployed instance.
# MESSAGING_CORS_ORIGINS="https://jobtrack-frontend.example.com"

# Optional: rate limiting. Defaults are deliberately permissive (flood protection,
# not usage friction). The audit's stricter reference values are noted alongside.
# REST, per IP, across all HTTP routes (audit reference: 10 / 60000ms):
# MESSAGING_REST_THROTTLE_LIMIT=100
# MESSAGING_REST_THROTTLE_TTL_MS=60000
# WebSocket "message:send", per user (audit reference: 5 / 10000ms):
# MESSAGING_WS_SEND_LIMIT=5
# MESSAGING_WS_SEND_TTL_MS=10000
# WebSocket connection handshake, per IP (audit reference: 3 / 60000ms):
# MESSAGING_WS_CONNECT_LIMIT=10
# MESSAGING_WS_CONNECT_TTL_MS=60000
