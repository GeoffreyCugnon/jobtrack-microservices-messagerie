# Connection string used by Prisma for this isolated instance's database.
# Points to this instance's dedicated PostgreSQL database.
# Local dev (docker-compose.yml, bundled postgres service):
MESSAGING_DATABASE_URL="postgresql://messaging:messaging@localhost:5432/messaging?schema=public"
# jobtrack-server prod (docker-compose.prod.yml, postgres-db from ../../infra/):
# MESSAGING_DATABASE_URL="postgresql://messaging:<password>@postgres-db:5432/messaging?schema=public"

# Secret used to verify the JWT presented by the host project's clients (HS256).
# The token's `sub` claim is treated as the authenticated user id.
MESSAGING_JWT_SECRET="change-me-in-every-deployed-instance"

# Optional: reject any token whose `iat` is older than this (guards against
# non-expiring tokens). Accepts a timespan ("24h", "7d") or seconds ("3600").
# Default "24h" (enforced). Set to "off" to disable the backstop entirely.
# MESSAGING_JWT_MAX_AGE="24h"

# NATS server used to publish integration events (pub/sub only, never request/response).
# Local dev: nats://localhost:4222 — jobtrack-server prod: nats://nats:4222 (../../infra/)
MESSAGING_NATS_URL="nats://localhost:4222"

# Optional: publish the outbox through JetStream (persistent stream) instead of
# core NATS fire-and-forget. The stream is created/updated at connect time
# (subjects: messaging.>). Consumers still receive the same subjects.
# MESSAGING_NATS_JETSTREAM=false
# MESSAGING_NATS_STREAM_NAME=MESSAGING
# MESSAGING_NATS_STREAM_MAX_AGE_MS=   # e.g. 1209600000 for 14 days; unset = keep forever

# Optional: how often the transactional outbox drains pending events to NATS
# (ms). A wake() after each write already triggers an immediate drain; this is
# the safety-net interval. Default 5000.
# MESSAGING_OUTBOX_DRAIN_MS=5000

# Optional: shared Redis for rate limiting across instances behind a load
# balancer. Unset = in-memory buckets (single instance). ioredis connection URL.
# MESSAGING_REDIS_URL="redis://localhost:6379"

# Optional: structured logs. Level default "info" in prod, "debug" otherwise.
# pino-pretty is used only outside production/test.
# MESSAGING_LOG_LEVEL=info

# Optional: interactive OpenAPI docs served at /docs. Default on.
# MESSAGING_ENABLE_DOCS=true

# Optional: retention purge (daily at 03:00). Deletes AuditLog + published
# OutboxEvent rows older than RETENTION_DAYS, and failed OutboxEvent rows older
# than RETENTION_FAILED_DAYS. Set ENABLED=false to skip the job entirely.
# MESSAGING_RETENTION_ENABLED=true
# MESSAGING_RETENTION_DAYS=90
# MESSAGING_RETENTION_FAILED_DAYS=180

# Optional: encrypt Message.content (and MessageVersion.content) at rest with
# AES-256-GCM. 32 bytes, base64 or hex. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset = content stored in clear text. Rows written before a key is added stay
# readable; do not rotate/remove the key while `v1:` rows exist.
# MESSAGING_CONTENT_ENCRYPTION_KEY=""

# Optional: HTTP port (defaults to 3100)
# PORT=3100

# Port hôte exposé par docker-compose.prod.yml (mapping vers le 3100 du conteneur)
# MESSAGING_PORT=3100

# Optional: reverse-proxy topology, for correct client-IP resolution in rate
# limiting (Express `trust proxy` + WebSocket X-Forwarded-For). Default: 1 (a
# single proxy hop: nginx / traefik / k8s ingress). Use "false" for direct
# exposure with no proxy; also accepts an integer hop count, "loopback", an IP
# or a CIDR.
# MESSAGING_TRUST_PROXY=1

# Optional: allowed browser origins for CORS (HTTP + Socket.IO), comma-separated.
# When unset, defaults to the Vite dev origins (localhost:5173, localhost:5174 and
# their 127.0.0.1 variants). Set this explicitly for any deployed instance —
# on jobtrack-server, the Frontend's public origin (e.g. "http://<IP_EC2>:80"
# today, no TLS/reverse-proxy/domain yet — see Frontend .env.example FRONTEND_PORT).
# MESSAGING_CORS_ORIGINS="https://jobtrack-frontend.example.com"

# Optional: rate limiting. Defaults are deliberately permissive (flood protection,
# not usage friction). The audit's stricter reference values are noted alongside.
# REST, per IP, across all HTTP routes (audit reference: 10 / 60000ms):
# MESSAGING_REST_THROTTLE_LIMIT=100
# MESSAGING_REST_THROTTLE_TTL_MS=60000
# WebSocket "message:send", per user (audit reference: 5 / 10000ms):
# MESSAGING_WS_SEND_LIMIT=5
# MESSAGING_WS_SEND_TTL_MS=10000
# WebSocket connection handshake, per IP (audit reference: 3 / 60000ms):
# MESSAGING_WS_CONNECT_LIMIT=10
# MESSAGING_WS_CONNECT_TTL_MS=60000
